# Human Capital Service — environment
# (audit L2 25 Okt: disamakan dengan var yang benar-benar dibaca config.go/viper
#  — versi lama memakai pola service-account yang sudah tidak dipakai)

# Server
SERVER_PORT=8081
SERVER_HOST=0.0.0.0

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hcdb
DB_SSLMODE=disable

# Redis (optional — fail-open jika tidak tersedia)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (harus cocok dengan SSO — dipakai JWKS middleware utk fallback HMAC)
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRATION=1h

# SSO — service token client credentials (dari tabel service_registries SSO)
SSO_URL=http://localhost:8080
SERVICE_NAME=human-capital
SERVICE_CLIENT_ID=hc-xxxxxxxx
SERVICE_CLIENT_SECRET=changeme

# Cache service token (optional)
SSO_CACHE_ENABLED=true
SSO_CACHE_TTL=15m

# Superadmin bypass permission-check (ID user SSO, dipisah koma)
SUPER_ADMIN_IDS=1

# Logger
LOGGER_LEVEL=info
LOGGER_FORMAT=json

# CORS (production: domain portal; staging: https://stg-bwise.binawan.ac.id)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# Permission service (middleware RequirePermission/CheckAccess)
PERMISSION_SERVICE_URL=http://localhost:8082
