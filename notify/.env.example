# ===== Server =====
SERVER_PORT=8092
SERVER_HOST=0.0.0.0

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=macbook
DB_PASSWORD=
DB_NAME=kit_db
DB_SSLMODE=disable

# ===== Redis (optional) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT (MUST match SSO JWT_SECRET) =====
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===== SSO Integration =====
SSO_URL=http://localhost:8070
PERMISSION_SERVICE_URL=http://localhost:8082

# ===== Service Identity (for service-to-service auth via OAuth2 Client Credentials) =====
SERVICE_NAME=my-service
SERVICE_CLIENT_ID=your-client-id-from-sso
SERVICE_CLIENT_SECRET=your-client-secret-from-sso

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3002
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# ===== Logging =====
LOGGER_LEVEL=info
LOGGER_FORMAT=json
# Kanal notifikasi (opsional — tanpa env, kanal mati & outbox retry lalu failed)
WA_WEBHOOK_URL=
WA_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@binawan.ac.id
# Web-push PWA (aktif bila berisi; pengiriman v1 menyusul)
PUSH_VAPID_SUBJECT=
PUSH_VAPID_PUBLIC=
PUSH_VAPID_PRIVATE=
