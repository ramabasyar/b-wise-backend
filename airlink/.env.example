# Airlink — Portal Pengelolaan Jaringan Binawan
# Salin ke .env dan sesuaikan nilai

# Server
SERVER_PORT=8087

# RADIUS DB (FreeRADIUS PostgreSQL @ arjuna) — READ ONLY
RADIUS_DB_DSN="host=10.123.123.22 port=5432 user=airlink_ro password=<read-only-password> dbname=radius sslmode=disable"

# RADIUS SSH (utk issue/revoke cert via helper)
RADIUS_SSH_HOST=10.123.120.25
RADIUS_SSH_USER=freerad

# SSO (utk self-sync permission + auth)
SSO_URL=http://127.0.0.1:8080
SERVICE_NAME=airlink
SERVICE_CLIENT_ID=airlink
SERVICE_CLIENT_SECRET=<service-registry-secret>
PERMISSION_SERVICE_URL=http://127.0.0.1:8082

# JWT (fallback utk middleware)
JWT_SECRET=<jwt-secret>

# Logger
LOGGER_LEVEL=info
LOGGER_FORMAT=json
