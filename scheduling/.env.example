# ===== Server =====
SERVER_PORT=8085
SERVER_HOST=0.0.0.0

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kit_db
DB_SSLMODE=disable

# ===== Redis (optional) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT (MUST match SSO JWT_SECRET) =====
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===== SSO Integration =====
SSO_URL=http://localhost:8080
PERMISSION_SERVICE_URL=http://localhost:8082

# ===== Service Identity (for service-to-service auth via OAuth2 Client Credentials) =====
SERVICE_NAME=my-service
SERVICE_CLIENT_ID=your-client-id-from-sso
SERVICE_CLIENT_SECRET=your-client-secret-from-sso

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3002
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# ===== Logging =====
LOGGER_LEVEL=info
LOGGER_FORMAT=json
