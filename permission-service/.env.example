# Server
SERVER_PORT=8081
SERVER_HOST=0.0.0.0
SERVER_MAX_BODY_SIZE=10485760  # 10MB

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kit_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (MUST match Permission Service JWT secret)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=24h

# SSO Service
SSO_URL=http://localhost:8080
SSO_SERVICE_ACCOUNT_EMAIL=service@starterkit.io
SSO_SERVICE_ACCOUNT_PASSWORD=changeme
SSO_CACHE_ENABLED=true
SSO_CACHE_TTL=15m

# Logger
LOGGER_LEVEL=info
LOGGER_FORMAT=json

# CORS (allow Permission Service)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,https://myapp.com,https://admin.myapp.com
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400
